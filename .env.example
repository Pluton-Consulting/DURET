# Serveur
HEADSCALE_IP=127.0.0.1   # nginx reste INTERNE : c'est Caddy qui expose
VPN_IP=100.64.0.1        # IP Headscale du VPS (`tailscale ip -4`)
APP_HOSTNAME=duret.pluton-consulting.fr
ACME_EMAIL=              # adresse pour Let's Encrypt
GANDI_API_TOKEN=         # PAT Gandi (admin.gandi.net), PAS une cle API

# PostgreSQL
POSTGRES_DB=duret_sols
POSTGRES_USER=duret_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://duret_user:CHANGE_ME@postgres:5432/duret_sols

# Magic Link — Resend (resend.com — gratuit jusqu'à 3 000 emails/mois)
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=Duret-Sols <Duret-Sols@duret-sols.fr>
APP_URL=http://100.64.0.1  # URL publique du frontend (IP Headscale)

# NextAuth
NEXTAUTH_URL=https://duret.pluton-consulting.fr
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# JWT Backend
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# LLM — Claude API (Anthropic)
ANTHROPIC_API_KEY=

# LLM — Ollama local (optionnel)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_LIGHT=mistral:7b

# Langfuse
LANGFUSE_SECRET_KEY=CHANGE_ME
LANGFUSE_PUBLIC_KEY=CHANGE_ME
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_SALT=CHANGE_ME
LANGFUSE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Daytona (optionnel — phase 2)
# Laisser vide pour utiliser le fallback subprocess local
# Obtenir sur https://app.daytona.io
DAYTONA_API_KEY=

# ── Ingestion (connecteurs + extraction navigateur) ─────────────────────
# Secret partagé du webhook d'ingestion (Make.com + agent navigateur → RAG)
INGESTION_WEBHOOK_SECRET=

# ── Agent Navigateur agentique (browser-use, conteneur browser-worker) ──
BROWSER_AGENT_ENABLED=false                # true pour activer
BROWSER_WORKER_URL=http://browser-worker:9000
BROWSER_LLM_PROVIDER=openrouter           # deepseek | groq | openrouter | longcat | openai
BROWSER_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free   # free + tool-calling (rate-limité)
BROWSER_AGENT_MAX_STEPS=40
BROWSER_APPROVAL_TIMEOUT_S=1800
BROWSER_USE_VISION=false
BROWSER_READONLY=true                     # sécurité : pas de saisie/soumission de formulaire (recommandé)
# Allowlist stricte des domaines autorisés (CSV). Vide = aucune tâche possible.
BROWSER_ALLOWED_DOMAINS=
# Clé du provider choisi ci-dessus (au moins une requise pour activer) :
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GROQ_API_KEY=
OPENROUTER_API_KEY=
LONGCAT_API_KEY=

# ── Embeddings RAG (base vectorielle) ───────────────────────────────────
# gemini = gratuit, 1536 dims natif (aucune migration), idéal petit VPS.
EMBEDDING_PROVIDER=gemini                  # gemini | openai | ollama
GOOGLE_API_KEY=                            # Google AI Studio (aistudio.google.com) — tier gratuit
# OPENAI_API_KEY=                          # si EMBEDDING_PROVIDER=openai
# OLLAMA_EMBEDDING_MODEL=bge-m3            # si EMBEDDING_PROVIDER=ollama (⚠ 1024 dims → migration schéma)
EMBEDDING_WORKER_ENABLED=true

# App
ENVIRONMENT=production
DEBUG=false
ALLOWED_HOSTS=100.64.0.1
